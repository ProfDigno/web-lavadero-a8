				</textElement>
				<textFieldExpression><![CDATA[$F{descrip}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0">
				<reportElement x="345" y="0" width="52" height="12"/>
				<box>
					<pen lineWidth="0.0"/>
