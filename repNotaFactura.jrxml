<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FacturaNota" language="groovy" pageWidth="595" pageHeight="842" columnWidth="563" leftMargin="12" rightMargin="20" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="pidfactura" class="java.lang.Integer"/>
	<parameter name="total_letras" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select f.idfactura as idfactura,
f.numero as nro,
to_char(f.fecha_emision,'yyyy-MM-dd') as emision,
'' as ttletra
,f.total as ttpagar,
(0) as ttiva5,
f.iva_10 as ttiva10,
f.iva_10 as ttiva,
coalesce(f.cliente_ruc, cl.ruc) as ruc,
coalesce(f.cliente_nombre, cl.nombre) as cliente,
'' as telef,
coalesce(f.cliente_direccion, cl.direccion, '') as direc
from facturas f
left join clientes cl on cl.idcliente = f.fk_idcliente
cross join generate_series(1, 3) as copia
where f.idfactura=$P{pidfactura}
order by copia]]>
	</queryString>
	<field name="idfactura" class="java.lang.Integer"/>
	<field name="nro" class="java.lang.String"/>
	<field name="emision" class="java.lang.String"/>
	<field name="ttletra" class="java.lang.String"/>
	<field name="ttpagar" class="java.math.BigDecimal"/>
	<field name="ttiva5" class="java.lang.Integer"/>
	<field name="ttiva10" class="java.math.BigDecimal"/>
	<field name="ttiva" class="java.math.BigDecimal"/>
	<field name="ruc" class="java.lang.String"/>
	<field name="cliente" class="java.lang.String"/>
	<field name="telef" class="java.lang.String"/>
	<field name="direc" class="java.lang.String"/>
