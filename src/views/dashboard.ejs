<%- include('partials/header') %>
<div class="page-head">
  <div>
    <h1>Inicio</h1>
    <p>Resumen operativo del dia</p>
  </div>
  <a class="button" href="/lavados">Nuevo lavado</a>
</div>

<form class="toolbar" method="get" action="/">
  <label>
    Fecha
    <input type="date" name="fecha" value="<%= fecha %>">
  </label>
  <button type="submit">Ver</button>
  <% if (canEvent('caja-ocultar')) { %>
    <a class="button secondary" href="/caja?fecha=<%= fecha %>">Ver caja</a>
  <% } %>
</form>

<section class="metrics">
  <article><span>Ingresos caja</span><strong><%= formatMoney(caja.resumen.ingresos) %></strong></article>
  <article><span>Egresos caja</span><strong><%= formatMoney(caja.resumen.egresos) %></strong></article>
  <article><span>Neto caja</span><strong><%= formatMoney(caja.resumen.neto) %></strong></article>
  <article><span>Efectivo a contar</span><strong><%= formatMoney(caja.resumen.efectivoAContar) %></strong></article>
  <article><span>Lavados</span><strong><%= resumen.lavados %></strong></article>
</section>

<section class="metrics">
  <article><span>Emitidos</span><strong><%= resumen.emitidos %></strong></article>
  <article><span>Creditos</span><strong><%= resumen.creditos %></strong></article>
  <article><span>Pagados</span><strong><%= resumen.pagados %></strong></article>
  <article><span>Anulados</span><strong><%= resumen.anulados %></strong></article>
  <article><span>Total</span><strong><%= formatMoney(resumen.total) %></strong></article>
  <article><span>Personal 40%</span><strong><%= formatMoney(resumen.comision) %></strong></article>
  <article><span>Lavadero 60%</span><strong><%= formatMoney(resumen.saldo) %></strong></article>
</section>

<section class="grid two">
  <div>
    <h2>Comisiones</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Personal</th><th>Lavados</th><th>Servicios</th><th>Comision</th></tr></thead>
        <tbody>
          <% comisiones.forEach((item) => { %>
            <tr>
              <td><%= item.personal_nombre %></td>
              <td><%= item.total_lavados_emitidos %></td>
              <td><%= formatMoney(item.total_servicios) %></td>
              <td><%= formatMoney(item.total_comision_40) %></td>
            </tr>
          <% }) %>
          <% if (!comisiones.length) { %><tr><td colspan="4">Sin movimientos.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
  <div>
    <h2>Ultimos lavados</h2>
    <div class="list">
      <% ultimos.forEach((lavado) => { %>
        <div class="row-link" data-row-link="/lavados/<%= lavado.id %>" tabindex="0" role="link">
          <a href="/lavados/<%= lavado.id %>"><strong>#<%= lavado.id %> - <%= formatLavadoVehicle(lavado) %><%= lavado.marca_modelo ? ' - ' + lavado.marca_modelo : '' %></strong></a>
          <% if (lavado.fecha_creado) { %>
            <span><%= formatDateTimeShort(lavado.fecha_creado) %></span>
          <% } %>
          <span><%= lavado.personal_nombre %> · <%= lavado.estado %> · <%= formatMoney(lavado.total) %></span>
          <%- include('partials/payment_chip', { nombre: lavado.forma_pago, icono: lavado.forma_pago_icono, color: lavado.forma_pago_color }) %>
          <% if (lavado.estado !== 'ANULADO' && lavado.estado !== 'CREDITO' && lavado.estado !== 'PAGADO') { %>
            <div class="payment-actions dashboard-payment-actions" aria-label="Cambiar forma de pago">
              <% formasPago.forEach((forma) => { %>
                <form method="post" action="/lavados/<%= lavado.id %>/forma-pago">
                  <input type="hidden" name="fk_idforma_pago" value="<%= forma.id %>">
                  <input type="hidden" name="redirect_to" value="/?fecha=<%= fecha %>">
                  <button
                    class="payment-button <%= Number(forma.id) === Number(lavado.fk_idforma_pago) ? 'is-active' : '' %>"
                    style="--payment-color: <%= forma.color || '#687385' %>"
                    title="<%= forma.nombre %>"
                    aria-label="Cambiar a <%= forma.nombre %>"
                    data-payment-confirm
                    data-lavado-id="#<%= lavado.id %>"
                    data-auto="<%= formatLavadoVehicle(lavado) %> - <%= lavado.marca_modelo %>"
                    data-personal="<%= lavado.personal_nombre %>"
                    data-total="<%= formatMoney(lavado.total) %>"
                    data-pago-actual="<%= lavado.forma_pago %>"
                    data-pago-nuevo="<%= forma.nombre %>"
                    type="submit"
                    <%= Number(forma.id) === Number(lavado.fk_idforma_pago) ? 'disabled' : '' %>>
                    <span>
                      <% if (forma.icono_ruta && String(forma.icono_ruta).startsWith('/uploads/')) { %>
                        <img src="<%= forma.icono_ruta %>" alt="">
                      <% } else { %>
                        <%= paymentIconLabel(forma.icono_ruta) %>
                      <% } %>
                    </span>
                  </button>
                </form>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>
      <% if (!ultimos.length) { %><p class="empty">Todavia no hay lavados.</p><% } %>
    </div>
  </div>
</section>
<div class="modal-backdrop is-hidden" data-payment-modal>
  <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="payment-modal-title">
    <h2 id="payment-modal-title">Confirmar forma de pago</h2>
    <dl class="modal-facts">
      <dt>Lavado</dt><dd data-modal-lavado></dd>
      <dt>Auto</dt><dd data-modal-auto></dd>
      <dt>Personal</dt><dd data-modal-personal></dd>
      <dt>Total</dt><dd data-modal-total></dd>
      <dt>Pago actual</dt><dd data-modal-pago-actual></dd>
      <dt>Nuevo pago</dt><dd data-modal-pago-nuevo></dd>
    </dl>
    <p>Desea cambiar la forma de pago?</p>
    <div class="modal-actions">
      <button type="button" data-payment-confirm-yes>SI</button>
      <button type="button" class="secondary" data-payment-confirm-no>NO</button>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
