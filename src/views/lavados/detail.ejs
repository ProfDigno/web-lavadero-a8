<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Lavado #<%= lavado.id %></h1>
    <p class="wash-vehicle" style="--vehicle-color: <%= lavado.forma_pago_color || '#115e59' %>"><%= lavado.chapa %> - <%= lavado.marca_modelo %></p>
  </div>
  <div class="actions">
    <a class="button secondary" href="/lavados">Volver</a>
    <% if (lavado.estado !== 'ANULADO') { %>
      <a class="button" href="/facturas/nueva?fk_idlavado=<%= lavado.id %>">Facturar</a>
    <% } %>
    <span class="badge <%= lavado.estado.toLowerCase() %>"><%= lavado.estado %></span>
  </div>
</div>

<section class="grid two">
  <div class="panel">
    <h2>Datos</h2>
    <dl class="facts">
      <dt>Cliente</dt><dd><%= lavado.cliente_nombre || 'Sin nombre' %></dd>
      <dt>RUC</dt><dd><%= lavado.ruc || '-' %></dd>
      <dt>Personal</dt><dd><%= lavado.personal_nombre %></dd>
      <dt>Condicion</dt><dd><%= lavado.condicion %></dd>
      <dt>Forma pago</dt><dd><%- include('../partials/payment_chip', { nombre: lavado.forma_pago, icono: lavado.forma_pago_icono, color: lavado.forma_pago_color }) %></dd>
      <dt>Creado</dt><dd><%= formatDateTime(lavado.fecha_creado) %> por <%= lavado.creado_por %></dd>
      <% if (lavado.estado === 'ANULADO') { %>
        <dt>Anulado</dt><dd><%= formatDateTime(lavado.anulado_en) %> por <%= lavado.anulado_por %></dd>
      <% } %>
    </dl>
  </div>
  <div class="panel">
    <h2>Totales</h2>
    <div class="metrics compact">
      <article><span>Total</span><strong><%= formatMoney(lavado.total) %></strong></article>
      <article><span>Personal 40%</span><strong><%= formatMoney(lavado.comision_personal) %></strong></article>
      <article><span>Lavadero 60%</span><strong><%= formatMoney(lavado.saldo_lavadero) %></strong></article>
    </div>
  </div>
</section>

<section class="panel">
  <h2>Servicios</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Servicio</th><th>Precio cargado</th></tr></thead>
      <tbody>
        <% servicios.forEach((servicio) => { %>
          <tr><td><%= servicio.nombre %></td><td><%= formatMoney(servicio.precio) %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<% if (lavado.estado !== 'ANULADO') { %>
  <section class="panel stack wash-edit-panel">
    <div class="section-title">
      <h2>Editar lavado</h2>
      <span class="hint">Cambie lavadores, servicios o precios</span>
    </div>
    <form method="post" action="/lavados/<%= lavado.id %>/editar" class="stack wash-form" data-edit-wash-form>
      <div class="grid two">
        <label>
          RUC
          <input name="cliente_ruc" value="<%= lavado.ruc || '' %>" data-uppercase>
        </label>
        <label>
          Nombre del cliente
          <input name="cliente_nombre" value="<%= lavado.cliente_nombre || '' %>" data-uppercase>
        </label>
        <label>
          Grupo cliente
          <select name="fk_idgrupo_cliente">
            <option value="">Sin grupo</option>
            <% grupos.forEach((grupo) => { %>
              <option value="<%= grupo.idgrupo_cliente %>" <%= Number(lavado.fk_idgrupo_cliente || 0) === Number(grupo.idgrupo_cliente) ? 'selected' : '' %>><%= grupo.nombre %><%= grupo.es_credito ? ' - credito' : '' %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <div class="choice-group">
        <span class="choice-label">Lavador/es</span>
        <div data-personal-inputs>
          <% personalIds.forEach((personalId) => { %><input type="hidden" name="fk_idpersonal" value="<%= personalId %>"><% }) %>
        </div>
        <div class="choice-buttons" data-personal-buttons>
          <% personal.forEach((persona) => { %>
            <button type="button" class="choice-button <%= personalIds.includes(String(persona.id)) ? 'is-selected' : '' %>" data-personal-id="<%= persona.id %>"><%= persona.nombre %></button>
          <% }) %>
        </div>
      </div>

      <div class="services-box">
        <div class="section-title">
          <h3>Servicios</h3>
          <button class="secondary" type="button" data-add-service>Agregar servicio</button>
        </div>
        <div data-services-list>
          <% servicios.forEach((servicio) => { %>
            <div class="service-line">
              <select name="fk_idservicio" required data-service-price>
                <option value="">Servicio</option>
                <% serviciosDisponibles.forEach((disponible) => { %>
                  <option value="<%= disponible.id %>" data-price="<%= disponible.precio_base %>" <%= Number(disponible.id) === Number(servicio.fk_idservicio) ? 'selected' : '' %>><%= disponible.grupo_nombre ? disponible.grupo_nombre + ' - ' : '' %><%= disponible.nombre %></option>
                <% }) %>
              </select>
              <input name="precio" value="<%= servicio.precio %>" inputmode="numeric" pattern="[0-9]*" placeholder="Precio" required data-price-input>
              <button class="icon danger" type="button" data-remove-service aria-label="Quitar servicio">x</button>
            </div>
          <% }) %>
        </div>
        <template data-service-template>
          <div class="service-line">
            <select name="fk_idservicio" required data-service-price>
              <option value="">Servicio</option>
              <% serviciosDisponibles.forEach((servicio) => { %>
                <option value="<%= servicio.id %>" data-price="<%= servicio.precio_base %>"><%= servicio.grupo_nombre ? servicio.grupo_nombre + ' - ' : '' %><%= servicio.nombre %></option>
              <% }) %>
            </select>
            <input name="precio" inputmode="numeric" pattern="[0-9]*" placeholder="Precio" required data-price-input>
            <button class="icon danger" type="button" data-remove-service aria-label="Quitar servicio">x</button>
          </div>
        </template>
        <div class="totals">
          <span>Total <strong data-total>0</strong></span>
          <span>Personal 40% <strong data-comision>0</strong></span>
          <span>Lavadero 60% <strong data-saldo>0</strong></span>
        </div>
      </div>
      <div class="actions">
        <button type="submit">Guardar cambios</button>
        <% if (lavado.estado !== 'CREDITO') { %>
          <button class="pass-credit-button" type="submit" name="pasar_a_credito" value="1" data-pass-credit>Pasar a crédito</button>
        <% } %>
      </div>
    </form>
  </section>

  <section class="grid two">
    <% if (lavado.estado !== 'CREDITO') { %>
      <form class="panel stack" method="post" action="/lavados/<%= lavado.id %>/forma-pago">
        <h2>Cambiar forma de pago</h2>
        <label>
          Forma de pago
          <select name="fk_idforma_pago" required>
            <% formasPago.forEach((forma) => { %>
              <option value="<%= forma.id %>" <%= Number(forma.id) === Number(lavado.fk_idforma_pago) ? 'selected' : '' %>><%= forma.nombre %></option>
            <% }) %>
          </select>
        </label>
        <input type="hidden" name="redirect_to" value="/lavados/<%= lavado.id %>">
        <button type="submit">Guardar forma de pago</button>
      </form>
    <% } %>

    <form class="panel stack danger-zone" method="post" action="/lavados/<%= lavado.id %>/anular" data-anular-form>
      <h2>Anular lavado</h2>
      <p>La anulacion conserva el registro y descuenta la comision acumulada del personal.</p>
      <button class="danger" type="submit">Anular</button>
    </form>
  </section>

  <div class="modal-backdrop is-hidden" data-credit-modal role="dialog" aria-modal="true" aria-labelledby="credit-modal-title">
    <section class="credit-modal-panel" data-credit-modal-panel>
      <div class="credit-modal-header">
        <div class="credit-modal-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 3 3.8 6.5v5.2c0 4.6 3.3 7.9 8.2 9.3 4.9-1.4 8.2-4.7 8.2-9.3V6.5L12 3z"></path>
            <path d="M12 8v4m0 3h.01"></path>
          </svg>
        </div>
        <div>
          <h2 id="credit-modal-title" data-credit-modal-title>Pasar lavado a crédito</h2>
          <p data-credit-modal-subtitle>Verifique los datos antes de continuar.</p>
        </div>
        <button class="credit-modal-close" type="button" data-credit-modal-cancel aria-label="Cerrar">×</button>
      </div>

      <div class="credit-modal-facts">
        <div class="credit-modal-fact">
          <span>Cliente</span>
          <strong data-credit-client>Sin nombre</strong>
        </div>
        <div class="credit-modal-fact">
          <span>RUC</span>
          <strong data-credit-ruc>Sin RUC</strong>
        </div>
        <div class="credit-modal-fact">
          <span data-credit-group-label>Grupo cliente</span>
          <strong data-credit-group>Sin grupo</strong>
        </div>
        <div class="credit-modal-total">
          <span>Monto del lavado</span>
          <strong data-credit-total>Gs. 0</strong>
        </div>
      </div>

      <p class="credit-modal-message" data-credit-modal-message>
        El lavado quedará asociado a un crédito por grupo.
      </p>

      <div class="credit-validation-alert is-hidden" data-credit-validation-alert role="alert">
        <div class="credit-validation-alert-icon" aria-hidden="true">!</div>
        <div>
          <h3>Datos incompletos</h3>
          <p data-credit-validation-message></p>
        </div>
        <button class="credit-validation-accept" type="button" data-credit-validation-accept>Aceptar</button>
      </div>

      <div class="credit-modal-actions" data-credit-modal-actions>
        <button class="secondary" type="button" data-credit-modal-cancel>Cancelar</button>
        <button class="credit-modal-confirm" type="button" data-credit-modal-confirm>Continuar</button>
      </div>
    </section>
  </div>

  <div class="modal-backdrop is-hidden" data-anular-modal role="dialog" aria-modal="true" aria-labelledby="anular-modal-title">
    <section class="anular-modal-panel" data-anular-modal-panel>
      <div class="anular-modal-header">
        <div class="anular-modal-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 3 3.8 6.5v5.2c0 4.6 3.3 7.9 8.2 9.3 4.9-1.4 8.2-4.7 8.2-9.3V6.5L12 3z"></path>
            <path d="M12 8v4m0 3h.01"></path>
          </svg>
        </div>
        <div>
          <h2 id="anular-modal-title">¿Anular lavado?</h2>
          <p>Esta acción descontará la comisión acumulada.</p>
        </div>
        <button class="anular-modal-close" type="button" data-anular-modal-cancel aria-label="Cerrar">×</button>
      </div>

      <div class="anular-modal-facts">
        <div class="anular-modal-fact">
          <span>Lavado</span>
          <strong data-anular-id>#<%= lavado.id %></strong>
        </div>
        <div class="anular-modal-fact">
          <span>Cliente</span>
          <strong data-anular-cliente><%= lavado.cliente_nombre || 'Sin nombre' %></strong>
        </div>
        <div class="anular-modal-fact">
          <span>Vehículo</span>
          <strong data-anular-vehiculo><%= [lavado.chapa, lavado.marca_modelo].filter(Boolean).join(' - ') || 'Sin datos' %></strong>
        </div>
        <div class="anular-modal-fact">
          <span>Personal</span>
          <strong data-anular-personal><%= lavado.personal_nombre || 'Sin personal' %></strong>
        </div>
        <div class="anular-modal-total">
          <span>Monto a anular</span>
          <strong data-anular-total><%= formatMoney(lavado.total) %></strong>
        </div>
      </div>

      <p class="anular-modal-warning">
        El registro se conservará como anulado, pero sus montos y comisiones dejarán de participar en los totales.
      </p>

      <div class="anular-modal-actions">
        <button class="secondary" type="button" data-anular-modal-cancel>Cancelar</button>
        <button class="anular-modal-confirm" type="button" data-anular-modal-confirm>Anular lavado</button>
      </div>
    </section>
  </div>
<% } %>
<%- include('../partials/footer') %>
